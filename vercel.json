{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "regions": ["hnd1"],
  "functions": {
    "api/index.mjs": {
      "excludeFiles": "{.env,.env.*,data/evidence_storage/**}"
    }
  },
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "/api"
    },
    {
      "source": "/health",
      "destination": "/api"
    },
    {
      "source": "/mcp",
      "destination": "/api"
    },
    {
      "source": "/oauth/:path*",
      "destination": "/api"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "/api"
    },
    {
      "source": "/.well-known/oauth-authorization-server/:path*",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
