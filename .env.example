NODE_ENV=development
PORT=4000
# Runtime connection: Session Pooler (5432) for local/persistent services;
# Transaction Pooler (6543) for serverless production runtimes.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/qa_management_dev
# Optional migration-only Session Pooler URI. Falls back to DATABASE_URL when omitted.
# MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/qa_management_dev
# Backward-compatible alias for a separately stored Production migration URI.
# PRODUCTION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/qa_management_prod
# Always use a disposable PostgreSQL database for integration tests.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/qa_management_test

# Comma-separated HTTPS hosts permitted for direct image/video evidence previews.
# Provider previews (Google Drive, YouTube, Loom, Vimeo) are configured in code.
EVIDENCE_DIRECT_MEDIA_HOST_ALLOWLIST=media.example.com
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ISSUER=qa-management-api
JWT_AUDIENCE=qa-management-web
JWT_ACCESS_TTL_MINUTES=30
CORS_ORIGIN=http://localhost:3000
COOKIE_SAME_SITE=lax
DATABASE_SSL=false
# Local storage is for development/test only. Production requires google_drive and a shared folder ID.
ATTACHMENT_STORAGE_PROVIDER=local
# ATTACHMENT_STORAGE_PROVIDER=google_drive
# GOOGLE_DRIVE_ROOT_FOLDER_ID=replace-with-shared-drive-or-folder-id
# Use one of: GOOGLE_APPLICATION_CREDENTIALS=/secure/path/service-account.json
# or GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ─── Firebase / FCM (Backend) ────────────────────────────────────────────────
# Use ONE of the following auth methods:
# 1. JSON string of service account (recommended for cloud deployments):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# 2. Path to service account file (recommended for local dev):
# FIREBASE_SERVICE_ACCOUNT_PATH=/secure/path/to/firebase-service-account.json
# 3. GOOGLE_APPLICATION_CREDENTIALS env var (ADC, for GCP-hosted environments)
FIREBASE_PROJECT_ID=your-firebase-project-id

# ─── Firebase / FCM (Frontend — Vite) ────────────────────────────────────────
# Frontend variables live in apps/web/.env.example.
