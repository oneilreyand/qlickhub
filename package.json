{
  "name": "qlick-hub",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "packageManager": "npm@10.5.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "uuid": "11.1.1"
  },
  "scripts": {
    "prepare": "husky",
    "build": "npm --prefix packages/contracts run build && npm --prefix apps/api run build && npm --prefix apps/web run build",
    "lint": "eslint apps/api/src apps/web/src packages/contracts/src",
    "format": "prettier --write .",
    "typecheck": "npm --prefix packages/contracts run typecheck && npm --prefix apps/api run typecheck && npm --prefix apps/web run typecheck",
    "test": "npm --prefix packages/contracts run test && npm --prefix apps/web run test && npm --prefix apps/api run test:integration",
    "validate": "npm run lint && npm run typecheck",
    "env:check": "node scripts/checkEnv.mjs",
    "dev:web": "npm --prefix apps/web run dev",
    "build:web": "npm --prefix apps/web run build",
    "typecheck:web": "npm --prefix apps/web run typecheck",
    "dev:api": "npm --prefix apps/api run dev",
    "build:api": "npm --prefix apps/api run build",
    "typecheck:api": "npm --prefix apps/api run typecheck",
    "db:migrate": "npm --prefix apps/api run db:migrate",
    "db:migrate:prod": "NODE_ENV=production npm --prefix apps/api run db:migrate",
    "db:seed": "npm --prefix apps/api run db:seed:full",
    "db:reset": "npm --prefix apps/api run db:reset:admin"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^24.1.3",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
