# Canonical frontend template for local development.
# Run `npm run env:setup:local`; Vite reads the ignored apps/web/.env.local.
# Every VITE_* value is embedded in the browser bundle. Never put secrets here.
VITE_API_URL=http://localhost:4000/v1

# Firebase web-app configuration (public identifiers, not service-account credentials).
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
# Optional:
# VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
