# REFERENCE ONLY: configure these public values in the Vercel Production environment.
# Every VITE_* value is embedded in the browser bundle and must never contain a secret.
# Keep /v1 for the recommended same-origin web + API deployment.
VITE_API_URL=/v1

# Firebase Web App Config (Public Browser Identifiers)
VITE_FIREBASE_API_KEY=your-production-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-production-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-production-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-production-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-production-sender-id
VITE_FIREBASE_APP_ID=your-production-app-id
