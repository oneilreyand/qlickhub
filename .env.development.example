# ─── Qlick Hub — Backend Development Environment (.env.development) ──────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173

# Database Connection (Local PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/qa_management_dev
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/qa_management_test
DATABASE_SSL=false

# Authentication & JWT (Minimum 32 characters)
JWT_ACCESS_SECRET=local-development-secret-key-min-32-chars-for-dev
JWT_ISSUER=qa-management-api
JWT_AUDIENCE=qa-management-web
JWT_ACCESS_TTL_MINUTES=60
COOKIE_SAME_SITE=lax

# CORS Origins (comma-separated for local frontend)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Attachment Storage (Local filesystem for dev)
ATTACHMENT_STORAGE_PROVIDER=local

# Security & Direct Media Previews
EVIDENCE_DIRECT_MEDIA_HOST_ALLOWLIST=localhost,127.0.0.1,media.example.com

# ─── Email / SMTP Configuration ───────────────────────────────────────────────
# (Isi dengan akun Gmail / SMTP untuk mengaktifkan pengiriman email fisik)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-google-app-password-16-digits
# SMTP_FROM="Qlick Hub Dev" <your-email@gmail.com>

# ─── Firebase / FCM (Optional in Dev) ─────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-account.json
