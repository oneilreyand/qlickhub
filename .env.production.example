# REFERENCE ONLY: configure these values in the Vercel Production environment.
# Do not copy this file over the local root `.env`, commit real values, or expose
# backend variables through a VITE_* name.
# ─── Qlick Hub — Backend Production Environment ──────────────────────────────
NODE_ENV=production
DATABASE_POOL_MAX=1
PORT=4000
APP_URL=https://qlickhub.vercel.app

# Database Connection (Supabase / Cloud PostgreSQL with Transaction Pooler)
DATABASE_URL=postgres://postgres.YOUR_PROJECT_REF:YOUR_STRONG_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_SSL=true

# Release-runner only; do not add this higher-privilege URI to the Vercel runtime.
# Inject it only while checking/applying approved canonical migrations.
# MIGRATION_DATABASE_URL=postgres://postgres.YOUR_PROJECT_REF:YOUR_STRONG_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# TEST_DATABASE_URL belongs only in a disposable local/CI test environment.

# Authentication & JWT (Generate a 64+ char random secret, e.g. using `openssl rand -hex 32`)
JWT_ACCESS_SECRET=replace-with-a-cryptographically-secure-random-secret-key-at-least-32-chars
JWT_ISSUER=qa-management-api
JWT_AUDIENCE=qa-management-web
JWT_ACCESS_TTL_MINUTES=30
COOKIE_SAME_SITE=lax

# Production CORS Origin (Strict production frontend domain, no wildcards)
CORS_ORIGIN=https://qlickhub.vercel.app

# Attachment Storage (Production uses Google Drive / S3 cloud storage)
ATTACHMENT_STORAGE_PROVIDER=google_drive
GOOGLE_DRIVE_ROOT_FOLDER_ID=replace-with-production-google-drive-folder-id
# JSON string of Google Cloud service account with Drive API access:
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Security & Direct Media Previews
EVIDENCE_DIRECT_MEDIA_HOST_ALLOWLIST=res.cloudinary.com,drive.google.com

# Distributed link-preview rate limiting (backend-only; separate resource per environment)
LINK_PREVIEW_RATE_LIMIT_STORE=upstash
UPSTASH_REDIS_REST_URL=https://your-production-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-production-upstash-rest-token
RATE_LIMIT_KEY_SECRET=replace-with-a-separate-random-secret-at-least-32-characters

# ─── Email / SMTP Configuration (Production) ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=replace-with-smtp-app-password
SMTP_FROM="Qlick Hub" <no-reply@yourdomain.com>

# ─── Firebase / FCM Push Notifications ────────────────────────────────────────
FIREBASE_PROJECT_ID=your-production-firebase-project-id
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
